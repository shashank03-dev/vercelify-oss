#!/usr/bin/env bash
# vfy — Vercelify from your terminal, using the servers paired in the app.
#
#   vfy apps                    every app with its status and URL
#   vfy deploy APP              deploy now (APP = name or uuid)
#   vfy logs APP [LINES]        runtime logs
#   vfy rollback APP COMMIT     put an earlier commit back live
#   vfy env pull APP [FILE]     write the app's production variables to FILE (.env)
#   vfy open APP                open the app's URL
#   vfy status                  the server's health checks
#   vfy alerts                  what the server reported lately
#   vfy backup                  start a backup now
#   vfy sleep APP [MINUTES|off] stop APP after MINUTES without visits (default 30)
#   vfy config check [DIR]      what DIR's vercel.json (+ vercelify.json) would do
#   vfy config push APP [DIR]   apply DIR's vercel.json to APP (any Git host)
#   vfy config sync APP         read APP's vercel.json from its GitHub repository now
#   vfy config show|rm APP      its rules and where they came from / remove them
#   vfy crons APP [run PATH]    APP's cron jobs and their last runs / run one now
#   vfy servers                 paired servers (* = selected in the app)
#
# On servers running Vercelify's own engine (no Coolify) also:
#   vfy deploy APP [--no-follow]  deploy and stream the build log (exit 1 if it fails)
#   vfy logs APP [LINES] [-f]   the app's output; -f keeps following it
#   vfy rollback APP COMMIT|#N  back to an earlier deployment (commit or number)
#   vfy restart APP             restart the running app
#   vfy env set APP K=V…        set variables (secret; --plain, --build)
#   vfy env push APP [FILE]     import a .env file (default .env)
#   vfy services [add ID [NAME]]  the service catalogue (Umami, MinIO…) / add one
#   vfy why APP                 AI: why APP's last deployment failed and how to fix it
#                               (Gemma 4 on your own server, through its Ollama)
#   vfy why --log FILE          the same for any build log, with the Ollama on this
#                               machine; no server needed. [--vercel-json FILE]
#       --provider ollama|server|gemini   gemini = Gemma 4 through the Gemini API
#                               (needs GEMINI_API_KEY)
#
#   -s, --server NAME           use another paired server than the selected one
#
# Reads the Mac app's settings (VFY_SETTINGS overrides the path). Tokens go to
# curl on stdin, never on the command line. Needs curl and jq; written for
# the bash 3.2 that macOS ships. AI settings: VFY_AI_MODEL (gemma4:e2b),
# VFY_OLLAMA_URL (http://localhost:11434), VFY_GEMINI_MODEL (gemma-4-26b-a4b-it).

set -euo pipefail

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; N=$'\e[0m'
else
  B=''; D=''; G=''; Y=''; R=''; N=''
fi
die() { printf '%svfy: %s%s\n' "$R" "$*" "$N" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() { sed -n '2,/^$/p' "$0" | sed -e '/^$/d' -e 's/^# \{0,1\}//'; }

settings_file() {
  if [[ -n "${VFY_SETTINGS:-}" ]]; then echo "$VFY_SETTINGS"; return; fi
  local f
  for f in "$HOME/Library/Application Support/dev.vercelify.cockpit/settings.json" \
           "${XDG_CONFIG_HOME:-$HOME/.config}/dev.vercelify.cockpit/settings.json"; do
    [[ -r "$f" ]] && { echo "$f"; return; }
  done
  die "no paired server found — open the Vercelify app and pair one first"
}

SERVER=''
args=()
while (( $# )); do
  case "$1" in
    -s|--server) SERVER=${2:?--server needs a name}; shift ;;
    -h|--help|help) usage; exit 0 ;;
    *) args+=("$1") ;;
  esac
  shift
done
set -- ${args[@]+"${args[@]}"}

have jq || die "jq is missing (brew install jq)"
have curl || die "curl is missing"

# --- vfy why: an open-weight model explains a failed build ------------------
# The prompt matches cockpit/src/lib/explain.ts (a cockpit test keeps the two
# in sync). Small log, capped answer: an old laptop's CPU reads every line.
AI_MODEL=${VFY_AI_MODEL:-gemma4:e2b}
AI_MAX_TOKENS=400
OLLAMA_URL=${VFY_OLLAMA_URL:-http://localhost:11434}
GEMINI_MODEL=${VFY_GEMINI_MODEL:-gemma-4-26b-a4b-it}
GEMINI_URL=${VFY_GEMINI_URL:-https://generativelanguage.googleapis.com/v1beta}
EXPLAIN_SYSTEM="You are Vercelify's deploy doctor. A deployment failed on a self-hosted Vercelify server:
Coolify builds the app with Nixpacks or a Dockerfile inside a Linux container on an old laptop.
Linux file names are case-sensitive, the build cannot see the developer's machine,
and environment variables come only from the app's settings.
Read the build log and answer in exactly this format, under 120 words:
**Cause:** one sentence naming the failing step and the root cause.
**Fix:** the exact change (file and line, setting, or command).
**Check:** one command to confirm the fix locally before pushing again.
Use only facts from the log. If the log does not show the cause, say what to look for next."

# stdin → the error lines with context, then the last 30 lines (… marks gaps).
trim_log() {
  awk '
    { line[NR] = $0; l = tolower($0)
      if (l ~ /(error|err!|failed|failure|fatal|cannot|can.t|could not|not found|no such file|denied|killed|out of memory|exit code|exited with|segmentation|panic|traceback|exception|missing|undefined|unresolved|enoent|eacces|enomem)/)
        for (j = NR - 2; j <= NR + 3; j++) keep[j] = 1 }
    END {
      for (j = NR - 29; j <= NR; j++) keep[j] = 1
      prev = 0
      for (i = 1; i <= NR; i++) if (keep[i]) { if (i > prev + 1) print "…"; print line[i]; prev = i }
    }'
}

# why_messages LOG [VERCEL_JSON] [HEADER] → the chat messages as JSON.
why_messages() {
  local log
  log=$(trim_log <<<"$1")
  (( ${#log} <= 5000 )) || log="…${log: -4999}"
  jq -nc --arg sys "$EXPLAIN_SYSTEM" --arg log "$log" --arg vj "${2:-}" --arg head "${3:-}" '
    (if $head == "" then "" else $head + "\n\n" end)
    + "Build log (error lines with context, then the last lines):\n```\n" + $log + "\n```"
    + (if $vj == "" then "" else "\n\nvercel.json:\n```json\n" + $vj[:1500] + "\n```" end)
    | [{role: "system", content: $sys}, {role: "user", content: .}]'
}

# stdin = an Ollama chat stream (NDJSON) → the answer, token by token, then
# which model answered and how fast. Dies on an error line.
print_stream() {
  local who=$1 line out tps=''
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    out=$(jq -r 'if .error then "E" + (.error | tostring)
      elif .done then "D" + (if (.eval_count // 0) > 0 and (.eval_duration // 0) > 0
        then " · \(.eval_count * 1e10 / .eval_duration | round / 10) tokens/s" else "" end)
      else "C" + (.message.content // "") end + "."' <<<"$line" 2>/dev/null) || continue
    out=${out%.}
    case "$out" in
      E*) printf '\n' >&2
          case "$out" in
            *"not found"*) die "${out#E} — download it first: ${WHY_PULL_HINT:-ollama pull $AI_MODEL}" ;;
            *) die "${out#E}" ;;
          esac ;;
      D*) tps=${out#D} ;;
      C*) printf '%s' "${out#C}" ;;
    esac
  done
  printf '\n\n%s— %s%s%s\n' "$D" "$who" "$tps" "$N"
}

# The installed model to use: VFY_AI_MODEL if set, else Gemma 4 E2B, another
# Gemma 4, then any chat model (stdin = model names, one per line).
pick_model() {
  local names
  names=$(cat)
  if [[ -n "${VFY_AI_MODEL:-}" ]]; then echo "$VFY_AI_MODEL"; return; fi
  if grep -qx 'gemma4:e2b' <<<"$names"; then echo gemma4:e2b; return; fi
  { grep '^gemma4' <<<"$names" || grep -vi embed <<<"$names" || true; } | head -1
}

why_gemini() { # MESSAGES → answer (Gemma 4 through the Gemini API)
  local body out err answer try
  [[ -n "${GEMINI_API_KEY:-}" ]] || die "GEMINI_API_KEY is not set — create a free key at https://aistudio.google.com/apikey and export it"
  # Gemma takes the instructions as part of the user turn.
  # Without minimal thinking, Gemma 4 spends the whole token budget on thought parts.
  body=$(jq -c '{contents: [{role: "user", parts: [{text: (map(.content) | join("\n\n"))}]}],
    generationConfig: {temperature: 0.2, maxOutputTokens: 1024, thinkingConfig: {thinkingLevel: "minimal"}}}' <<<"$1")
  # The API sometimes answers 500/503 for a moment: try up to three times.
  for try in 1 2 3; do
    out=$(printf 'header = "x-goog-api-key: %s"\n' "$GEMINI_API_KEY" |
      curl -sS -K - -X POST -H 'Content-Type: application/json' --max-time 180 --data "$body" \
        "${GEMINI_URL%/}/models/$GEMINI_MODEL:generateContent") || die "cannot reach the Gemini API"
    err=$(jq -r '.error.message // empty' <<<"$out" 2>/dev/null || echo "unexpected answer from the Gemini API")
    (( try < 3 )) && [[ "$(jq -r '.error.code // 0' <<<"$out" 2>/dev/null)" =~ ^50[03]$ ]] || break
    sleep "$try"
  done
  [[ -z "$err" ]] || die "Gemini API: $err"
  answer=$(jq -r '[.candidates[0].content.parts[]? | select(.thought != true) | .text] | join("") | sub("^\\s+"; "")' <<<"$out")
  [[ -n "$answer" ]] || die "Gemini API: empty answer ($(jq -r '.candidates[0].finishReason // "no candidates"' <<<"$out"))"
  printf '%s\n' "$answer"
  printf '\n%s— %s via the Gemini API (Gemma 4, Apache 2.0)%s\n' "$D" "$GEMINI_MODEL" "$N"
}

why_ollama() { # MESSAGES → answer streamed from the Ollama on this machine
  local body
  curl -sS --max-time 5 "${OLLAMA_URL%/}/api/version" >/dev/null 2>&1 ||
    die "Ollama isn't running at $OLLAMA_URL. Start it (open the Ollama app, or run: ollama serve), then: ollama pull $AI_MODEL"
  body=$(jq -c --arg m "$AI_MODEL" --argjson n "$AI_MAX_TOKENS" \
    '{model: $m, messages: ., stream: true, options: {temperature: 0.2, num_predict: $n}}' <<<"$1")
  printf '%sAsking %s on this machine… (the first answer loads the model, give it a moment)%s\n\n' "$D" "$AI_MODEL" "$N" >&2
  curl -sS -N --max-time 900 -H 'Content-Type: application/json' --data "$body" "${OLLAMA_URL%/}/api/chat" |
    print_stream "$AI_MODEL via Ollama at $OLLAMA_URL"
}

WHY_LOG='' WHY_VJ='' WHY_PROVIDER=${VFY_AI_PROVIDER:-}
if [[ "${1:-}" == why ]]; then
  shift
  why_app=''
  while (( $# )); do
    case "$1" in
      --log) WHY_LOG=${2:?--log needs a file (- = stdin)}; shift ;;
      --vercel-json) WHY_VJ=${2:?--vercel-json needs a file}; shift ;;
      --provider) WHY_PROVIDER=${2:?--provider needs ollama, server or gemini}; shift ;;
      -*) die "unknown option $1 for why" ;;
      *) why_app=$1 ;;
    esac
    shift
  done
  case "$WHY_PROVIDER" in ''|ollama|server|gemini) ;; *) die "--provider must be ollama, server or gemini" ;; esac
  if [[ -n "$WHY_VJ" ]]; then
    [[ -r "$WHY_VJ" ]] || die "cannot read $WHY_VJ"
    WHY_VJ=$(cat "$WHY_VJ")
  fi
  if [[ -n "$WHY_LOG" ]]; then
    # A log file: no paired server needed.
    if [[ "$WHY_LOG" == - ]]; then log=$(cat); else [[ -r "$WHY_LOG" ]] || die "cannot read $WHY_LOG"; log=$(cat "$WHY_LOG"); fi
    [[ -n "${log//[[:space:]]/}" ]] || die "the log is empty"
    msgs=$(why_messages "$log" "$WHY_VJ")
    case "$WHY_PROVIDER" in
      gemini) why_gemini "$msgs" ;;
      server) die "--provider server needs an app: vfy why APP" ;;
      *) why_ollama "$msgs" ;;
    esac
    exit 0
  fi
  set -- why ${why_app:+"$why_app"}
fi

SETTINGS=$(settings_file)

# The chosen server as one JSON object.
server_json() {
  jq -ce --arg s "$SERVER" '
    (if has("servers") then . else {servers: [.], active: .agent_url} end) as $c
    | if $s != "" then ($c.servers[] | select(.hostname == $s or .agent_url == $s))
      else (($c.servers[] | select(.agent_url == $c.active)) // $c.servers[0]) end' "$SETTINGS" 2>/dev/null |
    head -1 || true
}

SJ=$(server_json)
[[ -n "$SJ" ]] || die "no server ${SERVER:+named $SERVER }in $SETTINGS (see: vfy servers)"
field() { jq -r --arg k "$1" '.[$k] // ""' <<<"$SJ"; }

# A server on Vercelify's mesh (10.77.x.x, *.vfy): from a Mac in app mode
# the way in is vercelify-mesh's SOCKS proxy (as root, or on Linux, the
# mesh is routed and needs nothing). VFY_MESH_SOCKS forces a proxy.
MESH_STATUS=${VFY_MESH_STATUS:-"$HOME/Library/Application Support/Vercelify/run/mesh-status.json"}
on_mesh() {
  case "$(field agent_url | sed -E 's#^[a-z]+://##; s#[:/].*$##')" in 10.77.*|*.vfy) return 0 ;; esac
  return 1
}
PROXY=()
if on_mesh; then
  if [[ -n "${VFY_MESH_SOCKS:-}" ]] || jq -e '.interface == "userspace"' "$MESH_STATUS" >/dev/null 2>&1; then
    PROXY=(--socks5-hostname "${VFY_MESH_SOCKS:-127.0.0.1:7480}" --noproxy '')
  fi
fi
# curl, through the mesh proxy when the server needs it.
xcurl() { curl ${PROXY[@]+"${PROXY[@]}"} "$@"; }
unreachable() {
  if on_mesh; then die "cannot reach $(field hostname) — is vercelify-mesh running? (vercelify-mesh status)"; fi
  die "cannot reach $(field hostname) — is Tailscale connected?"
}

# api agent|coolify METHOD PATH [JSON] — prints the body; dies with the error.
api() {
  local kind=$1 method=$2 path=$3 body=${4:-} base token out code
  if [[ $kind == agent ]]; then
    base=$(field agent_url); token=$(field agent_token)
  else
    base=$(field coolify_url); token=$(field coolify_token)
    [[ -n "$base" && -n "$token" ]] || die "$(field hostname) is a worker without Coolify — use -s with your main server"
    base="${base%/}/api/v1"
  fi
  local opts=(-sS -X "$method" -K - -w '\n%{http_code}' --max-time 60 -H 'Accept: application/json')
  [[ -n "$body" ]] && opts+=(-H 'Content-Type: application/json' --data "$body")
  out=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | xcurl "${opts[@]}" "${base%/}$path") || unreachable
  code=${out##*$'\n'}
  out=${out%$'\n'*}
  if [[ "$code" != 2* ]]; then
    die "$(jq -r '.error // .message // empty' <<<"$out" 2>/dev/null || true) (HTTP $code)"
  fi
  printf '%s' "$out"
}

# Vercelify's own engine: a main server paired without a Coolify URL.
is_platform() { [[ "$(field role)" == main && -z "$(field coolify_url)" ]]; }

# APP name or uuid → uuid
app_uuid() {
  local want=${1:?which app? (name or uuid)} uuid
  if is_platform; then
    uuid=$(api agent GET /v1/platform/apps | jq -r --arg a "$want" '[.[] | select(.id == $a or .name == $a)][0].id // empty')
    [[ -n "$uuid" ]] || die "no app named $want (see: vfy apps)"
    echo "$uuid"
    return
  fi
  uuid=$(api coolify GET /applications | jq -r --arg a "$want" '[.[] | select(.uuid == $a or .name == $a)][0].uuid // empty')
  [[ -n "$uuid" ]] || die "no app named $want (see: vfy apps)"
  echo "$uuid"
}

# A coloured dot on a terminal; without colour (NO_COLOR, pipes) a symbol,
# so a warning still reads differently from ok.
dot() {
  local ok='●' warn='●' bad='●' idle='○'
  [[ -z "$G" ]] && { ok='✓'; warn='!'; bad='✗'; idle='-'; }
  case "$1" in
    idle) printf '%s%s%s' "$D" "$idle" "$N" ;;
    running*healthy|ok|true) printf '%s%s%s' "$G" "$ok" "$N" ;;
    *unhealthy*|exited*|bad|false) printf '%s%s%s' "$R" "$bad" "$N" ;;
    *) printf '%s%s%s' "$Y" "$warn" "$N" ;;
  esac
}


# MESSAGES → the model's answer, from the provider picked (default: the
# model on the server that built the app, through the agent's Ollama).
why_answer() {
  local msgs=$1 st model body
  case "$WHY_PROVIDER" in
    gemini) why_gemini "$msgs" ;;
    ollama) why_ollama "$msgs" ;;
    *)
      # Default: the model runs on the server that built the app (nothing
      # leaves your machines), through the agent's Ollama.
      st=$(api agent GET /v1/llm)
      [[ $(jq -r '.installed' <<<"$st") == true ]] ||
        die "$(field hostname) has no local AI yet — install it: Vercelify app → AI models → Install, or on the server: sudo vercelify llm install"
      [[ $(jq -r '.ready' <<<"$st") == true ]] ||
        die "Ollama on $(field hostname) isn't answering — app → AI models → Restart, or on the server: sudo vercelify llm start"
      model=$(jq -r '.models[].name' <<<"$st" | pick_model)
      [[ -n "$model" ]] ||
        die "no model on $(field hostname) yet — download Gemma 4: app → AI models, or on the server: sudo vercelify llm pull gemma4:e2b"
      body=$(jq -c --arg m "$model" --argjson n "$AI_MAX_TOKENS" '{model: $m, messages: ., stream: true, temperature: 0.2, max_tokens: $n}' <<<"$msgs")
      printf '%sAsking %s on %s…%s\n\n' "$D" "$model" "$(field hostname)" "$N" >&2
      WHY_PULL_HINT="sudo vercelify llm pull $model"
      printf 'header = "Authorization: Bearer %s"\n' "$(field agent_token)" |
        xcurl -sS -N -K - --max-time 900 -H 'Content-Type: application/json' --data "$body" "$(field agent_url)/v1/llm/chat" |
        print_stream "$model on $(field hostname), via Ollama"
      ;;
  esac
}

# --- the platform engine (/v1/platform) --------------------------------------

papi() { api agent "$1" "/v1/platform$2" "${3:-}"; }

# Follow a JSON-lines stream of the platform API (token on stdin).
pstream() {
  printf 'header = "Authorization: Bearer %s"\n' "$(field agent_token)" |
    xcurl -sS -N -K - --max-time 86400 "$(field agent_url)/v1/platform$1" ||
    die "the stream from $(field hostname) ended early"
}

# App → "health<TAB>label" (same rules as the app's list).
pstate_jq='
  def st: if .desired == "stopped" then ["idle", "stopped"]
    elif .desired == "sleeping" then ["idle", "asleep"]
    elif (.last_status // "") as $s | ["queued", "building", "deploying"] | index($s) then ["warn", .last_status]
    elif .current_deployment_id == null then (if .last_status == "failed" then ["bad", "failed"] else ["idle", "not deployed"] end)
    elif .last_status == "failed" then ["warn", "live, last deploy failed"]
    else ["ok", "live"] end;'

# A line of a log stream → text ([stderr] marked).
log_text='(if .stream == "stderr" or .stream == "error" then "[stderr] " else "" end) + .text'

platform_cmd() {
  local cmd=$1
  shift
  case "$cmd" in
    apps|ls)
      papi GET /apps | jq -r "$pstate_jq"' .[] | (st) as $s | [$s[0], .name, $s[1], (.url // ""), .id] | @tsv' |
        while IFS=$'\t' read -r h name label url id; do
          printf '%s %-22s %-26s %s %s%s%s\n' "$(dot "$h")" "$name" "$label" "$url" "$D" "$id" "$N"
        done
      ;;
    deploy)
      local app=${1:?which app? (name or id)} follow=1 d id st
      [[ "${2:-}" == --no-follow ]] && follow=0
      d=$(papi POST "/apps/$app/deploy" '{"force_rebuild":false}')
      id=$(jq -r .id <<<"$d")
      printf '%sDeploying %s (#%s)%s\n' "$B" "$app" "$(jq -r .number <<<"$d")" "$N"
      if (( follow == 0 )); then
        printf '%s`vfy apps` shows when it is live%s\n' "$D" "$N"
        return
      fi
      pstream "/deployments/$id/logs?follow=true" | jq --unbuffered -r "$log_text"
      d=$(papi GET "/deployments/$id")
      st=$(jq -r .status <<<"$d")
      case "$st" in
        healthy) printf '%s✓%s %s is live%s\n' "$G" "$N" "$app" "$(papi GET "/apps/$app" | jq -r 'if .url then " at \(.url)" else "" end')" ;;
        failed) die "the deployment failed: $(jq -r .error <<<"$d") (vfy why $app)" ;;
        *) die "the deployment ended $st" ;;
      esac
      ;;
    logs)
      local app=${1:?which app? (name or id)} lines=200 follow=0 a
      shift
      for a in "$@"; do
        case "$a" in
          -f|--follow) follow=1 ;;
          *[!0-9]*|'') die "usage: vfy logs APP [LINES] [-f]" ;;
          *) lines=$a ;;
        esac
      done
      if (( follow )); then
        pstream "/apps/$app/logs?follow=true&tail=$lines" | jq --unbuffered -r "$log_text"
      else
        papi GET "/apps/$app/logs?tail=$lines" | jq -r "$log_text"
      fi
      ;;
    rollback)
      local app=${1:?usage: vfy rollback APP COMMIT|#N} want=${2:?usage: vfy rollback APP COMMIT|#N} deps match n
      deps=$(papi GET "/apps/$app/deployments?limit=100" |
        jq -c '[.[] | select(.pr_number == null and (.status == "healthy" or .status == "superseded") and .image != "")]')
      if [[ "$want" =~ ^#[0-9]+$ ]]; then
        match=$(jq -c --argjson n "${want#\#}" '[.[] | select(.number == $n)]' <<<"$deps")
      elif [[ "$want" =~ ^[0-9a-f]{4,40}$ ]]; then
        match=$(jq -c --arg c "$want" '[.[] | select(.commit_sha | startswith($c))]' <<<"$deps")
      else
        die "give a commit SHA (4+ characters) or a deployment number like #12"
      fi
      n=$(jq length <<<"$match")
      (( n > 0 )) || die "no earlier live deployment of $app at $want (vfy rollback goes back to something that was live)"
      if (( n > 1 )); then
        # The same commit deployed several times: the newest of them.
        match=$(jq -c '[sort_by(-.number)[0]]' <<<"$match")
      fi
      [[ $(jq -r '.[0].current' <<<"$match") != true ]] || die "$want is already live"
      d=$(papi POST "/apps/$app/rollback" "$(jq -c '{deployment_id: .[0].id}' <<<"$match")")
      printf '%s✓%s rolling %s back to #%s %s(new deployment #%s)%s\n' "$G" "$N" "$app" "$(jq -r '.[0].number' <<<"$match")" "$D" "$(jq -r .number <<<"$d")" "$N"
      ;;
    restart)
      local app=${1:?which app? (name or id)}
      printf '%s✓%s restarted %s (%s container(s))\n' "$G" "$N" "$app" "$(papi POST "/apps/$app/restart" '{}' | jq -r .restarted)"
      ;;
    env)
      local sub=${1:-} app=${2:-}
      [[ -n "$app" ]] || die "usage: vfy env pull|set|push APP …"
      shift 2
      case "$sub" in
        pull)
          local file=${1:-.env} vars
          [[ ! -e "$file" ]] || [[ "${VFY_FORCE:-0}" == 1 ]] || die "$file exists — remove it or set VFY_FORCE=1"
          vars=$(papi GET "/apps/$app/env?reveal=true")
          ( umask 077
            jq -r '[.[] | select(.preview_only | not)] | sort_by(.key) | .[] | "\(.key)=\(.value // "" | @json)"' <<<"$vars" >"$file" )
          printf '%s✓%s %s variables written to %s (mode 600)\n' "$G" "$N" "$(wc -l <"$file" | tr -d ' ')" "$file"
          ;;
        set)
          local secret=true build=false body='[]' kv
          for kv in "$@"; do
            case "$kv" in
              --plain) secret=false ;;
              --build) build=true ;;
              *=*) body=$(jq -c --arg k "${kv%%=*}" --arg v "${kv#*=}" '. + [{key: $k, value: $v}]' <<<"$body") ;;
              *) die "usage: vfy env set APP KEY=VALUE… [--plain] [--build]" ;;
            esac
          done
          [[ "$body" != '[]' ]] || die "usage: vfy env set APP KEY=VALUE… [--plain] [--build]"
          body=$(jq -c --argjson s "$secret" --argjson b "$build" '{vars: map(. + {secret: $s, build: $b}), replace: false}' <<<"$body")
          printf '%s✓%s %s saved — deploy %s to use them\n' "$G" "$N" "$(papi PUT "/apps/$app/env" "$body" | jq -r '"\(.saved) variable\(if .saved == 1 then "" else "s" end)"')" "$app"
          ;;
        push)
          local file=${1:-.env}
          [[ -r "$file" ]] || die "no $file to import"
          printf '%s✓%s %s imported from %s — deploy %s to use them\n' "$G" "$N" \
            "$(papi POST "/apps/$app/env/import" "$(jq -nc --rawfile c "$file" '{content: $c, replace: false}')" | jq -r '"\(.saved) variable\(if .saved == 1 then "" else "s" end)"')" "$file" "$app"
          ;;
        *) die "usage: vfy env pull APP [FILE] | set APP KEY=VALUE… | push APP [FILE]" ;;
      esac
      ;;
    open)
      local url
      url=$(papi GET "/apps/${1:?which app? (name or id)}" | jq -r '.url // ""')
      [[ -n "$url" ]] || die "that app has no URL yet (add a domain in the app)"
      if have open; then open "$url"; elif have xdg-open; then xdg-open "$url"; else echo "$url"; fi
      ;;
    services)
      if [[ "${1:-}" == add ]]; then
        local id=${2:?usage: vfy services add ID [NAME]} name=${3:-${2}} a
        a=$(papi POST "/templates/$id" "$(jq -nc --arg n "$name" '{name: $n}')")
        printf '%s✓%s %s is being created from %s — vfy apps shows when it is live\n' "$G" "$N" "$(jq -r .name <<<"$a")" "$id"
      else
        papi GET /templates | jq -r '.[] | [.id, .name, (if .min_memory_mb >= 1024 then "\(.min_memory_mb / 1024) GB" else "\(.min_memory_mb) MB" end), .description] | @tsv' |
          while IFS=$'\t' read -r id name mem desc; do printf '%-13s %-13s %6s  %s%s%s\n' "$id" "$name" "$mem" "$D" "$desc" "$N"; done
      fi
      ;;
    why)
      local app=${1:?which app? (name or id)} dep log head msgs
      dep=$(papi GET "/apps/$app/deployments?limit=20" | jq -c '[.[] | select(.status == "failed")][0] // empty')
      [[ -n "$dep" ]] || { printf '%s✓%s no failed deployments of %s lately\n' "$G" "$N" "$app"; return; }
      log=$(papi GET "/deployments/$(jq -r .id <<<"$dep")/logs" | jq -r "$log_text")
      [[ -n "$log" ]] || die "that deployment has no build log"
      head=$(jq -r --arg app "$app" '"App: \($app)\nCommit: \(.commit_sha[:7]) \"\(.commit_message | split("\n")[0])\""' <<<"$dep")
      printf '%s%s failed at %s (%s)%s\n' "$B" "$app" "$(jq -r '.commit_sha[:7]' <<<"$dep")" "$(jq -r .created_at <<<"$dep")" "$N" >&2
      msgs=$(why_messages "$log" "$WHY_VJ" "$head")
      why_answer "$msgs"
      ;;
  esac
}

cmd=${1:-apps}
(( $# )) && shift
if is_platform; then
  case "$cmd" in
    apps|ls|deploy|logs|rollback|restart|env|open|services|why) platform_cmd "$cmd" "$@"; exit 0 ;;
  esac
fi
case "$cmd" in
  servers)
    jq -r '(if has("servers") then . else {servers: [.], active: .agent_url} end) as $c
      | $c.servers[] | [(if .agent_url == $c.active then "*" else " " end), .hostname, (.role // "main"), .agent_url] | @tsv' "$SETTINGS" |
      while IFS=$'\t' read -r mark name role url; do printf '%s %-20s %-7s %s\n' "$mark" "$name" "$role" "$url"; done
    ;;
  apps|ls)
    api coolify GET /applications | jq -r '.[] | [.name, .status, ((.fqdn // "") | split(",")[0]), .uuid] | @tsv' |
      while IFS=$'\t' read -r name status url uuid; do
        printf '%s %-22s %-18s %s %s%s%s\n' "$(dot "$status")" "$name" "${status%%:*}" "$url" "$D" "$uuid" "$N"
      done
    ;;
  deploy)
    uuid=$(app_uuid "${1:-}")
    api coolify POST "/deploy?uuid=$uuid&force=false" '{}' | jq -r '.deployments[0].message // "queued"'
    printf '%sfollow it in the app, or: vfy logs %s%s\n' "$D" "$1" "$N"
    ;;
  logs)
    uuid=$(app_uuid "${1:-}")
    lines=${2:-200}
    [[ "$lines" =~ ^[0-9]+$ ]] || die "LINES must be a number"
    api coolify GET "/applications/$uuid/logs?lines=$lines" | jq -r '.logs // ""'
    ;;
  rollback)
    uuid=$(app_uuid "${1:-}")
    commit=${2:?usage: vfy rollback APP COMMIT}
    [[ "$commit" =~ ^[0-9a-f]{4,40}$ ]] || die "COMMIT must be a commit SHA"
    # Coolify needs the full SHA; take it from the app's finished production
    # deployments (newest first), so a short one from `git log` works too.
    shas=$(api coolify GET "/deployments/applications/$uuid?take=100" |
      jq -r '[(.deployments // .)[] | select(.status == "finished" and (.pull_request_id // 0) == 0) | .commit // empty] | .[]')
    full=$(printf '%s\n' "$shas" | grep "^$commit" | sort -u || true)
    [[ -n "$full" ]] || die "no finished deployment of ${1} at $commit (rollback goes back to a commit that was live before)"
    [[ $(printf '%s\n' "$full" | wc -l) -eq 1 ]] || die "$commit matches several commits — give more characters"
    [[ "$full" != "$(printf '%s\n' "$shas" | head -1)" ]] || die "$commit is already live"
    api coolify POST "/applications/$uuid/rollback" "$(jq -nc --arg c "$full" '{commit: $c}')" | jq -r '.message // "rolling back"'
    ;;
  env)
    [[ "${1:-}" == pull ]] || die "usage: vfy env pull APP [FILE]"
    uuid=$(app_uuid "${2:-}")
    file=${3:-.env}
    [[ ! -e "$file" ]] || [[ "${VFY_FORCE:-0}" == 1 ]] || die "$file exists — remove it or set VFY_FORCE=1"
    envs=$(api coolify GET "/applications/$uuid/envs")
    ( umask 077
      jq -r '[.[] | select(.is_preview | not)] | sort_by(.key) | .[] | "\(.key)=\(.value // "" | @json)"' <<<"$envs" >"$file" )
    printf '%s✓%s %s variables written to %s (mode 600)\n' "$G" "$N" "$(wc -l <"$file" | tr -d ' ')" "$file"
    ;;
  open)
    uuid=$(app_uuid "${1:-}")
    url=$(api coolify GET "/applications/$uuid" | jq -r '(.fqdn // "") | split(",")[0]')
    [[ -n "$url" ]] || die "that app has no URL yet"
    if have open; then open "$url"; elif have xdg-open; then xdg-open "$url"; else echo "$url"; fi
    ;;
  status|doctor)
    printf '%s%s%s\n' "$B" "$(field hostname)" "$N"
    api agent GET /v1/doctor | jq -r '.checks[] | [.status, .label, .detail, (.fix // "")] | @tsv' |
      while IFS=$'\t' read -r st label detail fix; do
        printf '%s %-22s %s\n' "$(dot "$st")" "$label" "$detail"
        [[ -n "$fix" ]] && printf '  %s→ %s%s\n' "$D" "$fix" "$N"
      done
    ;;
  alerts)
    api agent GET /v1/alerts | jq -r '.alerts[:15][] | [(if .resolved then "ok" else .status end), .at, .title] | @tsv' |
      while IFS=$'\t' read -r st at title; do printf '%s %s  %s\n' "$(dot "$st")" "$at" "$title"; done
    ;;
  backup)
    api agent POST /v1/backup/run '{}' >/dev/null
    printf '%s✓%s backup of %s started (vfy status shows when it finished)\n' "$G" "$N" "$(field hostname)"
    ;;
  sleep)
    uuid=$(app_uuid "${1:-}")
    case "${2:-30}" in
      off) api agent PUT "/v1/sleep/$uuid" '{"enabled":false}' >/dev/null
           printf '%s✓%s %s stays awake\n' "$G" "$N" "$1" ;;
      *[!0-9]*) die "usage: vfy sleep APP [MINUTES|off]" ;;
      *) api agent PUT "/v1/sleep/$uuid" "$(jq -nc --argjson m "${2:-30}" '{enabled: true, idle_minutes: $m}')" >/dev/null
         printf '%s✓%s %s sleeps after %s idle minutes; the next visit wakes it\n' "$G" "$N" "$1" "${2:-30}" ;;
    esac
    ;;
  config)
    sub=${1:-}
    (( $# )) && shift
    # Upload body from DIR: vercel.json first, then vercelify.json (wins).
    files_json() {
      local dir=${1:-.} f body='[]'
      for f in vercel.json vercelify.json; do
        [[ -f "$dir/$f" ]] || continue
        body=$(jq -c --arg n "$f" --rawfile c "$dir/$f" '. + [{name: $n, content: $c}]' <<<"$body")
      done
      [[ "$body" != '[]' ]] || die "no vercel.json or vercelify.json in ${dir}"
      jq -c '{files: .}' <<<"$body"
    }
    # A summary (ProjectSummary) as one line, then its notes.
    summary() {
      jq -r '[(if .redirects > 0 then "\(.redirects) redirect\(if .redirects > 1 then "s" else "" end)" else empty end),
              (if .rewrites > 0 then "\(.rewrites) rewrite\(if .rewrites > 1 then "s" else "" end)" else empty end),
              (if .headers > 0 then "\(.headers) header rule\(if .headers > 1 then "s" else "" end)" else empty end),
              (if .firewall_rules > 0 then "\(.firewall_rules) firewall rule\(if .firewall_rules > 1 then "s" else "" end)" else empty end),
              (if (.crons | length) > 0 then "\(.crons | length) cron job\(if (.crons | length) > 1 then "s" else "" end)" else empty end),
              (if .clean_urls then "clean URLs" else empty end),
              (if .trailing_slash == true then "trailing slash" elif .trailing_slash == false then "no trailing slash" else empty end)]
             | if length == 0 then "no rules" else join(" · ") end'
    }
    notes() { jq -r '.warnings[]?' | while IFS= read -r w; do printf '  %s!%s %s\n' "$Y" "$N" "$w"; done; }
    show() { # ProjectInfo
      local info=$1
      printf '%s %s %s(%s)%s\n' "$(dot "$(jq -r 'if .error then "bad" elif .routes_active then "ok" else "idle" end' <<<"$info")")" \
        "$(jq '.summary' <<<"$info" | summary)" "$D" \
        "$(jq -r 'if .source == "upload" then "uploaded" else "from the repository at \((.commit // "")[:7])" end' <<<"$info")" "$N"
      jq -r '.error // empty' <<<"$info" | while IFS= read -r e; do printf '  %s✗%s %s\n' "$R" "$N" "$e"; done
      jq '.summary' <<<"$info" | notes
    }
    case "$sub" in
      check)
        out=$(api agent POST /v1/projects/check "$(files_json "${1:-.}")")
        printf '%s✓%s %s\n' "$G" "$N" "$(summary <<<"$out")"
        notes <<<"$out"
        ;;
      push)
        uuid=$(app_uuid "${1:-}")
        show "$(api agent PUT "/v1/projects/$uuid" "$(files_json "${2:-.}")")"
        ;;
      sync)
        uuid=$(app_uuid "${1:-}")
        show "$(api agent POST "/v1/projects/$uuid/sync" '{}')"
        ;;
      show|'')
        uuid=$(app_uuid "${1:-}")
        info=$(api agent GET /v1/projects | jq -c --arg k "$uuid" '.projects[] | select(.key == $k)')
        [[ -n "$info" ]] || die "${1} has no vercel.json applied (vfy config push ${1}, or vfy config sync ${1})"
        show "$info"
        ;;
      rm|remove)
        uuid=$(app_uuid "${1:-}")
        api agent DELETE "/v1/projects/$uuid" >/dev/null
        printf '%s✓%s %s is served as Coolify configures it\n' "$G" "$N" "$1"
        ;;
      *) die "usage: vfy config check [DIR] | push APP [DIR] | sync APP | show APP | rm APP" ;;
    esac
    ;;
  crons)
    uuid=$(app_uuid "${1:-}")
    if [[ "${2:-}" == run ]]; then
      path=${3:?usage: vfy crons APP run PATH}
      api agent POST "/v1/projects/$uuid/crons/run" "$(jq -nc --arg p "$path" '{path: $p}')" >/dev/null
      printf '%s✓%s %s started (vfy crons %s shows the result)\n' "$G" "$N" "$path" "$1"
    else
      api agent GET /v1/projects | jq -r --arg k "$uuid" '.projects[] | select(.key == $k) | .summary.crons[] |
        [(if .running then "warn" elif .last_run_at == null then "idle" elif (.last_status // 0) >= 200 and (.last_status // 0) < 300 then "ok" else "bad" end),
         .path, .schedule, (if .last_run_at then "\(.last_status // "no answer") at \(.last_run_at)" else "not run yet" end), (.next_run_at // "")] | @tsv' |
        while IFS=$'\t' read -r st path sched last next; do
          printf '%s %-24s %-14s %s  %snext %s%s\n' "$(dot "$st")" "$path" "$sched" "$last" "$D" "$next" "$N"
        done
    fi
    ;;
  why)
    uuid=$(app_uuid "${1:-}")
    dep=$(api coolify GET "/deployments/applications/$uuid?take=20" |
      jq -c '[(.deployments // .)[] | select(.status == "failed")][0] // empty')
    [[ -n "$dep" ]] || { printf '%s✓%s no failed deployments of %s lately\n' "$G" "$N" "$1"; exit 0; }
    duuid=$(jq -r '.deployment_uuid' <<<"$dep")
    log=$(api coolify GET "/deployments/$duuid" | jq -r '(.logs // "[]") | fromjson? // [] | .[]
      | select(.hidden | not) | (if .type == "stderr" then "[stderr] " else "" end) + .output')
    [[ -n "$log" ]] || die "that deployment has no build log"
    head=$(jq -r --arg app "$1" '"App: \($app)\nCommit: \((.commit // "")[:7]) \"\((.commit_message // "") | split("\n")[0])\""' <<<"$dep")
    printf '%s%s failed at %s (%s)%s\n' "$B" "$1" "$(jq -r '(.commit // "")[:7]' <<<"$dep")" "$(jq -r '.created_at // ""' <<<"$dep")" "$N" >&2
    msgs=$(why_messages "$log" "$WHY_VJ" "$head")
    why_answer "$msgs"
    ;;
  *) usage >&2; exit 2 ;;
esac

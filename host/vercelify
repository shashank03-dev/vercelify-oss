#!/usr/bin/env bash
# vercelify — day-2 operations for a Vercelify host.
set -Eeuo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
HOST_DIR=$(dirname "$SELF")
VERCELIFY_SRC=$(dirname "$HOST_DIR")
for lib in common system hardware storage docker tailscale coolify platform mesh cloudflare agent backup registry maintenance standby; do
  # shellcheck source=/dev/null
  . "$HOST_DIR/lib/$lib.sh"
done
# shellcheck source=/dev/null
[[ -r "$VERCELIFY_ETC/install.env" ]] && . "$VERCELIFY_ETC/install.env"
ROLE=${role:-main}

usage() {
  cat <<'EOF'
Usage: sudo vercelify <command> [args]

  status                 One-screen overview of every component
  doctor                 Check everything and explain how to fix problems
  pair [--refresh]       Show a one-time 8-character code for the Mac app (and the full
                         pairing code); --refresh also creates a new Coolify API token
  domain [DOMAIN] [--cloudflare-token TOKEN] [--force-dns]
                         Set or change the public domain (no args: back to private sslip.io)
  add-worker USER@HOST   Turn another machine (e.g. a Raspberry Pi on your tailnet) into a
                         Coolify build/deploy server
  llm [status|install [ssd|hdd]|pull MODEL|rm MODEL|chat MODEL PROMPT|start|stop|restart]
                         Local AI models (Ollama) on this machine
  autodeploy [list|add APP_UUID REPO [BRANCH] [--token T]|rm APP_UUID|check APP_UUID]
                         Deploy a Coolify app whenever its branch gets a new commit
  coolify [check|upgrade [VERSION|latest]]
                         Check Coolify's version and schema against Vercelify, or upgrade
                         Coolify on purpose (its own auto-update is off; default: the
                         version this release was tested with)
  backup [status|setup [--to REPO]…|run|list|restore [SNAP] [--instance]]
                         Encrypted nightly backups (restic) to the HDD, another server
                         (sftp:root@pi:/path) or S3; restore files or the whole server
  routes sync            Route public hostnames of apps on pooled servers through the
                         Cloudflare tunnel (also runs every 5 minutes by itself)
  registry [install|trust HOST:PORT|multiarch]
                         Private image registry on the tailnet: build on the strongest
                         machine, let small ones (a Pi) just pull
  mesh [status|init|invite [--device] [--role R]|join TOKEN [--name N]|nodes|revoke NAME|rotate]
                         Vercelify's own private network (WireGuard, vfy0): make this main
                         server its coordinator, invite and join machines, revoke them
  standby [NAME|off]     A worker that keeps a sealed copy of this main server (every 5 min)
  promote [--force]      On the standby: become the main server when the old one is gone
  demote [--force]       On a main server a standby replaced: step back, to rejoin as a worker
  tokens [list|revoke ID]
                         Devices paired with this server; revoke a lost one
  sleep [list|on APP_UUID [MINUTES] [--previews]|off APP_UUID]
                         Stop an app after idle minutes to free memory; the next visit
                         wakes it (a "waking up" page for a second or two)
  maintenance [status|on [HH:MM]|off|run]
                         Reboot for security updates in a nightly window, only when one
                         is needed and no deploy, backup or update is running
  logs [agent|guard|coolify|tunnel|setup|backup]
                         Follow logs of a component
  update [--edge|--stable|--ref TAG]
                         Install the latest release (keeps your data); rolls back by
                         itself if the new agent doesn't come up
  rollback               Go back to the version installed before the last update
  uninstall              Remove Vercelify's agent, guard, firewall and CLI (keeps Coolify + data)
  version
EOF
}

need_root() { [[ $EUID -eq 0 || "${VERCELIFY_TEST:-0}" == 1 ]] || die "run with sudo: sudo vercelify $*"; }
# Talking to the agent needs its token, which only root can read.
need_token() { [[ -r "$VERCELIFY_ETC/agent.token" ]] || die "run with sudo: sudo vercelify $*"; }

: "${AGENT_LOCAL_URL:=http://127.0.0.1:7420}"

# agent_api METHOD PATH [JSON] — prints the response body; dies with the
# agent's error message on failure. The token goes to curl on stdin, not argv.
agent_api() {
  local method=$1 path=$2 body=${3:-} out code msg
  local args=(-sS -X "$method" -K - -w '\n%{http_code}' --max-time "${API_TIMEOUT:-60}")
  [[ -n "$body" ]] && args+=(-H 'Content-Type: application/json' --data "$body")
  out=$(printf 'header = "Authorization: Bearer %s"\n' "$(<"$VERCELIFY_ETC/agent.token")" |
    curl "${args[@]}" "$AGENT_LOCAL_URL$path") ||
    die "the agent is not answering on $AGENT_LOCAL_URL — see: sudo vercelify doctor"
  code=${out##*$'\n'}
  out=${out%$'\n'*}
  if [[ "$code" != 2* ]]; then
    msg=$(jq -r '.error // .message // empty' <<<"$out" 2>/dev/null || true)
    die "${msg:-HTTP $code from the agent}"
  fi
  printf '%s' "$out"
}

human_bytes() { numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0}B"; }

svc_state() { systemctl is-active "$1" 2>/dev/null || true; }

line() { # line LABEL STATE DETAIL
  local color=$C_GREEN mark='●'
  case "$2" in
    ok|active|running|Running|mounted) color=$C_GREEN ;;
    warn|warning|degraded|activating|NeedsLogin) color=$C_YELLOW ;;
    *) color=$C_RED ;;
  esac
  printf '  %s%s%s %-18s %s%-12s%s %s\n' "$color" "$mark" "$C_RESET" "$1" "$color" "$2" "$C_RESET" "${3:-}"
}

cmd_status() {
  printf '\n%sVercelify%s on %s (%s)\n\n' "$C_BOLD" "$C_RESET" "$(hostname)" "$ROLE"
  local ts ip dns
  ts=$(ts_state); ip=$(ts_ipv4 || true); dns=$(ts_dns_name || true)
  line Tailscale "$ts" "${dns:-} ${ip:+($ip)}"
  line Docker "$(svc_state docker)" "$(docker ps -q 2>/dev/null | wc -l) running containers"
  if [[ $ROLE == main ]]; then
    local h
    h=$(curl -fsS -m 3 "$COOLIFY_URL_LOCAL/api/health" 2>/dev/null || echo down)
    line Coolify "$([[ $h == OK ]] && echo ok || echo down)" "http://${dns:-${ip:-localhost}}:8000"
    local proxy
    proxy=$(docker inspect -f '{{.State.Health.Status}}' coolify-proxy 2>/dev/null || echo missing)
    line "Proxy (Traefik)" "$([[ $proxy == healthy ]] && echo ok || echo "$proxy")" "ports 80/443"
    [[ -f "$SYSTEMD_DIR/cloudflared.service" ]] && line "Cloudflare tunnel" "$(svc_state cloudflared)" "${domain:+*.$domain}"
  fi
  line Agent "$(svc_state vercelify-agent)" ":7420"
  if docker inspect vercelify-ollama >/dev/null 2>&1; then
    local llm
    llm=$(curl -fsS -m 3 http://127.0.0.1:11434/api/version 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)
    line "AI (Ollama)" "$([[ -n "$llm" ]] && echo running || echo stopped)" "${llm:+v$llm, }port 11434"
  fi
  line "Power guard" "$(svc_state vercelify-power-guard)" "$(jq -r '"\(.state): \(.reason)"' /run/vercelify/power-guard.state 2>/dev/null || true)"
  if mountpoint -q "$STORAGE_MOUNT"; then
    line Storage mounted "$(df -h --output=used,size,pcent "$STORAGE_MOUNT" | tail -1 | awk '{print $1" / "$2" ("$3")"}') on $(findmnt -no SOURCE "$STORAGE_MOUNT")"
  else
    line Storage warn "single disk: $STORAGE_MOUNT is on /"
  fi
  line "System disk" ok "$(df -h --output=used,size,pcent / | tail -1 | awk '{print $1" / "$2" ("$3")"}')"
  echo
}

DOCTOR_FAILS=0
check() { # check "label" "fix hint" cmd...
  local label=$1 hint=$2; shift 2
  if "$@" >/dev/null 2>&1; then ok "$label"; else err "$label"; printf '      → %s\n' "$hint" >&2; DOCTOR_FAILS=$((DOCTOR_FAILS + 1)); fi
}

# agent_try METHOD PATH [JSON] — like agent_api, but fails quietly.
agent_try() {
  [[ -r "$VERCELIFY_ETC/agent.token" ]] || return 1
  ( agent_api "$@" ) 2>/dev/null
}

# Print a /v1/doctor report; returns 1 when any check is bad.
print_report() {
  local report=$1 status label detail fix bad=0 warned=0
  while IFS=$'\x1f' read -r status label detail fix; do
    case "$status" in
      ok) ok "$label — $detail" ;;
      warn) warn "$label — $detail"; warned=$((warned + 1)) ;;
      *) err "$label — $detail"; bad=$((bad + 1)) ;;
    esac
    [[ -n "$fix" && "$status" != ok ]] && printf '      → %s\n' "$fix" >&2
  done < <(jq -r '.checks[] | [.status, .label, .detail, (.fix // "")] | join("\u001f")' <<<"$report")
  echo >&2
  if (( bad )); then err "$bad problem(s), $warned warning(s)"; return 1; fi
  if (( warned )); then warn "no problems, $warned warning(s)"; else ok "all checks passed"; fi
}

# The agent's report is the one source of truth (the Mac app shows the same);
# the local checks below only run when the agent itself is down.
cmd_doctor() {
  step "Vercelify doctor"
  local report
  if report=$(API_TIMEOUT=90 agent_try GET "/v1/doctor?refresh=true") && [[ -n "$report" ]]; then
    print_report "$report"
    return
  fi
  warn "the agent is not answering — basic local checks only"
  check "Docker daemon running" "sudo systemctl restart docker; journalctl -u docker -n 50" docker info
  check "Tailscale connected" "sudo tailscale up --hostname=$(hostname -s)" bash -c '[[ "$(tailscale status --json | jq -r .BackendState)" == Running ]]'
  check "Agent answering" "sudo systemctl restart vercelify-agent; journalctl -u vercelify-agent -n 50" curl -fsS -m 3 "$AGENT_LOCAL_URL/v1/health"
  check "Agent token present" "sudo vercelify-agent --config $VERCELIFY_ETC/agent.toml token --write" test -s "$VERCELIFY_ETC/agent.token"
  if [[ $ROLE == main ]]; then
    check "Coolify healthy" "docker logs coolify --tail 50 (IPv6 disabled? Coolify's nginx needs it)" bash -c "[[ \"\$(curl -fsS -m 5 $COOLIFY_URL_LOCAL/api/health)\" == OK ]]"
  fi
  check "System disk < 90% full" "docker system prune -af --volumes=false; Coolify → Servers → Docker cleanup" bash -c '(( $(df --output=pcent / | tail -1 | tr -dc 0-9) < 90 ))'
  echo
  if (( DOCTOR_FAILS == 0 )); then ok "basic checks passed (start the agent for the full report)"; else err "$DOCTOR_FAILS problem(s) found"; return 1; fi
}

cmd_pair() {
  need_root pair
  if [[ "${1:-}" == --refresh && $ROLE == main ]]; then
    rm -f "$VERCELIFY_ETC/coolify.token"
    coolify_api_token
  fi
  local code short both
  # One call, one device token for both codes (agents before 0.2.1: two calls).
  if both=$("$AGENT_BIN" --config "$VERCELIFY_ETC/agent.toml" pair --short --with-code 2>/dev/null) &&
     [[ $(wc -l <<<"$both") -eq 2 ]]; then
    short=$(sed -n 1p <<<"$both")
    code=$(sed -n 2p <<<"$both")
  else
    code=$("$AGENT_BIN" --config "$VERCELIFY_ETC/agent.toml" pair)
    short=$("$AGENT_BIN" --config "$VERCELIFY_ETC/agent.toml" pair --short 2>/dev/null || true)
  fi
  if [[ -n "$short" ]]; then
    printf '\n  In the Vercelify app on your Mac, pick %s%s%s and type:\n\n      %s%s%s\n\n  (one use, valid for 15 minutes)\n' \
      "$C_BOLD" "$(hostname -s)" "$C_RESET" "$C_BOLD" "$short" "$C_RESET" >&2
  fi
  printf '\n  Or paste the full pairing code:\n\n  %s\n\n' "$code" >&2
  if have qrencode && [[ -t 1 ]]; then qrencode -t ansiutf8 -m 1 "$code"; fi
  printf '%s\n' "$code"
}

llm_wait() { # llm_wait KIND TARGET — follow a background task until it ends
  local kind=$1 target=$2 st t status finished err completed total last=''
  for _ in $(seq 1 "${LLM_WAIT_STEPS:-3600}"); do
    st=$(agent_api GET /v1/llm)
    t=$(jq -c --arg k "$kind" --arg t "$target" '[.tasks[] | select(.kind == $k and .target == $t)] | last // empty' <<<"$st")
    [[ -n "$t" ]] || die "the agent lost track of $target"
    IFS=$'\x1f' read -r status finished err completed total < <(jq -r '[.status, .done, (.error // ""), (.completed // 0), (.total // 0)] | map(tostring) | join("\u001f")' <<<"$t")
    local line="$status"
    (( total > 0 )) && line="$status  $(( completed * 100 / total ))% of $(human_bytes "$total")"
    [[ "$line" != "$last" ]] && { info "$line"; last=$line; }
    if [[ "$finished" == true ]]; then
      [[ -z "$err" ]] || die "$target: $err"
      return 0
    fi
    sleep "${LLM_POLL_SECS:-2}"
  done
  die "gave up waiting for $target (it may still finish: sudo vercelify llm)"
}

cmd_llm() {
  need_token llm
  local sub=${1:-status}
  (( $# )) && shift
  case "$sub" in
    status)
      local st
      st=$(agent_api GET /v1/llm)
      if [[ "$(jq -r .installed <<<"$st")" != true ]]; then
        info "Ollama is not installed — run: sudo vercelify llm install"
        return 0
      fi
      line Ollama "$(jq -r 'if .ready then "running" elif .running then "warn" else "stopped" end' <<<"$st")" "$(jq -r '.version // ""' <<<"$st")"
      jq -r '.endpoints[] | "  endpoint  \(.)"' <<<"$st"
      jq -r '.models[] | [.name, (.parameter_size // ""), .size_bytes] | map(tostring) | join("\u001f")' <<<"$st" |
        while IFS=$'\x1f' read -r name params size; do printf '  model     %-28s %-8s %s\n' "$name" "$params" "$(human_bytes "$size")"; done
      jq -r '.loaded[] | "  loaded    \(.name)"' <<<"$st"
      jq -r '.tasks[] | select(.done | not) | "  running   \(.kind) \(.target): \(.status)"' <<<"$st"
      ;;
    install)
      local tier=${1:-}
      [[ -z "$tier" ]] && { mountpoint -q "$STORAGE_MOUNT" 2>/dev/null && tier=hdd || tier=ssd; }
      [[ "$tier" == ssd || "$tier" == hdd ]] || die "storage must be ssd or hdd"
      agent_api POST /v1/llm/install "$(jq -nc --arg t "$tier" '{tier: $t}')" >/dev/null
      step "Installing Ollama (models on the ${tier^^})"
      llm_wait install "$(jq -r .image <<<"$(agent_api GET /v1/llm)")"
      ok "Ollama is running — try: sudo vercelify llm pull llama3.2:3b"
      ;;
    pull)
      local model=${1:?usage: vercelify llm pull MODEL (e.g. llama3.2:3b)}
      agent_api POST /v1/llm/models/pull "$(jq -nc --arg m "$model" '{model: $m}')" >/dev/null
      step "Downloading $model"
      llm_wait pull "$model"
      ok "$model is ready"
      ;;
    rm|delete)
      local model=${1:?usage: vercelify llm rm MODEL}
      agent_api POST /v1/llm/models/delete "$(jq -nc --arg m "$model" '{model: $m}')" >/dev/null
      ok "deleted $model"
      ;;
    chat)
      local model=${1:?usage: vercelify llm chat MODEL PROMPT} prompt=${2:-}
      [[ -n "$prompt" ]] || die "usage: vercelify llm chat MODEL PROMPT"
      API_TIMEOUT=900 agent_api POST /v1/llm/chat \
        "$(jq -nc --arg m "$model" --arg p "$prompt" '{model: $m, messages: [{role: "user", content: $p}]}')" |
        jq -r '.message.content'
      ;;
    start|stop|restart)
      API_TIMEOUT=120 agent_api POST "/v1/llm/$sub" '{}' >/dev/null
      ok "Ollama: $sub done"
      ;;
    *) die "unknown llm command '$sub' (see: vercelify help)" ;;
  esac
}

cmd_autodeploy() {
  need_token autodeploy
  local sub=${1:-list}
  (( $# )) && shift
  case "$sub" in
    list|ls)
      local st
      st=$(agent_api GET /v1/autodeploy)
      if [[ "$(jq '.watches | length' <<<"$st")" == 0 ]]; then
        info "no branches watched — add one in the Mac app or: sudo vercelify autodeploy add APP_UUID REPO [BRANCH]"
        return 0
      fi
      printf '  %-16s %-18s %-14s %-8s %-7s %s\n' APP NAME BRANCH STATE DEPLOYS "LAST CHECK / ERROR"
      jq -r '.watches[] | [.app_uuid, .name, .branch, (if .enabled then "on" else "paused" end), .deploys, (.last_error // .last_checked_at // "never")] | map(tostring) | join("\u001f")' <<<"$st" |
        while IFS=$'\x1f' read -r uuid name branch state deploys last; do
          printf '  %-16s %-18s %-14s %-8s %-7s %s\n' "$uuid" "${name:0:18}" "$branch" "$state" "$deploys" "$last"
        done
      ;;
    add)
      local uuid='' repo='' branch=main token='' have_token=0 pos=()
      while (( $# )); do
        case "$1" in
          --token) token=${2:?}; have_token=1; shift ;;
          *) pos+=("$1") ;;
        esac
        shift
      done
      uuid=${pos[0]:-}; repo=${pos[1]:-}; branch=${pos[2]:-main}
      [[ -n "$uuid" && -n "$repo" ]] || die "usage: vercelify autodeploy add APP_UUID REPO [BRANCH] [--token TOKEN]"
      local body
      body=$(jq -nc --arg a "$uuid" --arg r "$repo" --arg b "$branch" --arg t "$token" --argjson ht "$have_token" \
        '{app_uuid: $a, repo: $r, branch: $b} + (if $ht == 1 then {token: $t} else {} end)')
      agent_api POST /v1/autodeploy "$body" >/dev/null
      agent_api POST "/v1/autodeploy/$uuid/check" '{}' >/dev/null || true
      ok "pushes to $branch of $repo now deploy $uuid"
      ;;
    rm|remove)
      local uuid=${1:?usage: vercelify autodeploy rm APP_UUID}
      agent_api DELETE "/v1/autodeploy/$uuid" >/dev/null
      ok "auto-deploy removed for $uuid"
      ;;
    check)
      local uuid=${1:?usage: vercelify autodeploy check APP_UUID} w
      w=$(agent_api POST "/v1/autodeploy/$uuid/check" '{}')
      jq -r '"  head \(.last_commit // "?") · \(.deploys) automatic deploys" + (if .last_error then "\n  error: \(.last_error)" else "" end)' <<<"$w"
      ;;
    *) die "unknown autodeploy command '$sub' (see: vercelify help)" ;;
  esac
}

cmd_sleep() {
  need_token sleep
  local sub=${1:-list}
  (( $# )) && shift
  case "$sub" in
    list|ls|status)
      local st
      st=$(agent_api GET /v1/sleep)
      [[ "$(jq -r '.error // empty' <<<"$st")" ]] && warn "$(jq -r .error <<<"$st")"
      if [[ "$(jq '.settings | length' <<<"$st")" == 0 ]]; then
        info "no app sleeps when idle — turn it on: sudo vercelify sleep on APP_UUID [MINUTES]"
        return 0
      fi
      jq -r '.settings[] as $s | ([.targets[] | select(.app_uuid == $s.app_uuid)] | map("\(.hosts[0] // .key) \(.state)") | join(", ")) as $t
        | "  \($s.app_uuid)  after \($s.idle_minutes) min idle\(if $s.previews then " (and previews)" else "" end)  \($t)"' <<<"$st"
      ;;
    on)
      local uuid=${1:?usage: vercelify sleep on APP_UUID [MINUTES] [--previews]} minutes=30 previews=false
      shift
      while (( $# )); do
        case "$1" in
          --previews) previews=true ;;
          *) [[ "$1" =~ ^[0-9]+$ ]] || die "MINUTES must be a number"; minutes=$1 ;;
        esac
        shift
      done
      agent_api PUT "/v1/sleep/$uuid" "$(jq -nc --argjson m "$minutes" --argjson p "$previews" '{enabled: true, idle_minutes: $m, previews: $p}')" >/dev/null
      ok "$uuid sleeps after $minutes idle minutes and wakes on the next visit"
      ;;
    off)
      local uuid=${1:?usage: vercelify sleep off APP_UUID}
      agent_api PUT "/v1/sleep/$uuid" '{"enabled":false}' >/dev/null
      ok "$uuid stays awake"
      ;;
    *) die "unknown sleep command '$sub' (see: vercelify help)" ;;
  esac
}

cmd_domain() {
  need_root domain
  [[ $ROLE == main ]] || die "run this on the main host"
  local new='' token=${CF_API_TOKEN:-} force=0
  while (( $# )); do
    case "$1" in
      --cloudflare-token) token=${2:?}; shift ;;
      --force-dns) force=1 ;;
      -*) die "unknown option $1" ;;
      *) new=${1,,} ;;
    esac
    shift
  done
  local wildcard
  if [[ -z "$new" ]]; then
    wildcard="http://$(ts_ipv4).sslip.io"
  elif [[ -n "$token" ]]; then
    setup_cloudflare_domain "$new" "$token" "vercelify-$(hostname -s)" "$force"
    wildcard="http://$new"
  else
    wildcard="https://$new"
    info "point A records for $new and *.$new to your public IP and forward TCP 80/443 to this machine"
  fi
  if platform_engine; then
    local edge=false
    [[ -n "$token" && -n "$new" ]] && edge=true
    platform_set_domain "$wildcard" "$edge"
  else
    configure_coolify "$wildcard"
  fi
  local mode=''
  if [[ -n "$new" ]]; then [[ -n "$token" ]] && mode=cloudflare || mode=direct; fi
  sed -i '/^domain=/d; /^domain_mode=/d' "$VERCELIFY_ETC/install.env" 2>/dev/null || true
  printf 'domain=%s\ndomain_mode=%s\n' "$new" "$mode" >>"$VERCELIFY_ETC/install.env"
  ok "new apps will get ${wildcard/:\/\//:\/\/<app>.}"
  info "existing apps keep their URLs — change them in each app's Domains field"
}

cmd_add_worker() {
  need_root add-worker
  [[ $ROLE == main ]] || die "run this on the main host"
  local target=${1:?usage: vercelify add-worker USER@HOST}
  local host=${target#*@} pubkey key_uuid token ip
  pubkey=$(coolify_public_key) || die "could not find Coolify's SSH key"
  step "Preparing worker $target"
  info "you may be asked for $target's password (and sudo password) once"
  # Ship this exact version of the installer instead of downloading one.
  tar -C "$VERCELIFY_SRC" -cz --exclude target --exclude node_modules --exclude .git host install.sh Cargo.toml Cargo.lock crates agent 2>/dev/null |
    ssh -o StrictHostKeyChecking=accept-new "$target" \
      "rm -rf /tmp/vercelify-src && mkdir -p /tmp/vercelify-src && tar -xz -C /tmp/vercelify-src" ||
    die "could not copy the installer to $target"
  ssh -t -o StrictHostKeyChecking=accept-new "$target" \
    "sudo bash /tmp/vercelify-src/host/setup-host.sh --worker --hostname '${host%%.*}' --coolify-pubkey '$pubkey' -y" ||
    die "worker setup failed on $target"

  step "Registering $host in Coolify"
  ip=$(tailscale ip -4 "$host" 2>/dev/null | head -1 || true)
  ip=${ip:-$host}
  token=$(cat "$VERCELIFY_ETC/coolify.token" 2>/dev/null || true)
  key_uuid=$(coolify_private_key_uuid)
  if [[ -z "$token" || -z "$key_uuid" ]]; then
    warn "add it manually: Coolify → Servers → + Add → IP $ip, user root, key 'localhost's key'"
    return 0
  fi
  local body resp
  body=$(jq -nc --arg n "${host%%.*}" --arg ip "$ip" --arg k "$key_uuid" \
    '{name: $n, description: "Vercelify worker (Tailscale)", ip: $ip, port: 22, user: "root", private_key_uuid: $k, instant_validate: true}')
  resp=$(curl -fsS -m 30 -X POST -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
    --data "$body" "$COOLIFY_URL_LOCAL/api/v1/servers" 2>&1) || { warn "Coolify API: $resp"; return 0; }
  ok "worker registered (uuid $(jq -r .uuid <<<"$resp")) — Coolify is validating it now"
  info "pick it as the server when creating a resource, or as a build server in Server settings"
}

cmd_coolify() {
  need_root coolify
  [[ $ROLE == main ]] || die "run this on the main host"
  case "${1:-check}" in
    check|status)
      local current
      current=$(coolify_current_version || echo unknown)
      info "Coolify $current (this Vercelify release is tested with $COOLIFY_TESTED_VERSION)"
      [[ "$current" == "$COOLIFY_TESTED_VERSION" || "$current" == unknown ]] ||
        info "to move to the tested version: sudo vercelify coolify upgrade"
      coolify_schema_check
      ;;
    upgrade) coolify_upgrade "${2:-}"; coolify_schema_check || die "upgraded, but Vercelify needs an update for this Coolify version" ;;
    *) die "usage: vercelify coolify [check|upgrade [VERSION|latest]]" ;;
  esac
}

cmd_logs() {
  case "${1:-agent}" in
    agent) journalctl -u vercelify-agent -f -n 100 ;;
    guard|power) journalctl -u vercelify-power-guard -f -n 100 ;;
    coolify) docker logs -f --tail 100 coolify ;;
    tunnel|cloudflared) journalctl -u cloudflared -f -n 100 ;;
    setup) less +G "$VERCELIFY_LOG" ;;
    backup) tail -n 100 -f "$BACKUP_LOG" ;;
    *) die "unknown component $1" ;;
  esac
}

ROLLBACK_DIR=${ROLLBACK_DIR:-$VERCELIFY_LIB/rollback}
UNITS="vercelify-agent vercelify-power-guard vercelify-firewall"

# Keep what an update replaces, so a failed update can be undone.
snapshot_for_rollback() {
  local tmp="$ROLLBACK_DIR.new" u
  rm -rf "$tmp"
  mkdir -p "$tmp/units"
  [[ -x "$AGENT_BIN" ]] && cp -a "$AGENT_BIN" "$tmp/vercelify-agent"
  [[ -d "$VERCELIFY_LIB/host" ]] && cp -a "$VERCELIFY_LIB/host" "$tmp/host"
  [[ -f "$VERCELIFY_ETC/install.env" ]] && cp -a "$VERCELIFY_ETC/install.env" "$tmp/install.env"
  for u in $UNITS; do [[ -f "$SYSTEMD_DIR/$u.service" ]] && cp -a "$SYSTEMD_DIR/$u.service" "$tmp/units/"; done
  rm -rf "$ROLLBACK_DIR"
  mv "$tmp" "$ROLLBACK_DIR"
}

restore_rollback() {
  [[ -d "$ROLLBACK_DIR" ]] || die "nothing to roll back to ($ROLLBACK_DIR is missing)"
  [[ -f "$ROLLBACK_DIR/vercelify-agent" ]] && install -m 0755 "$ROLLBACK_DIR/vercelify-agent" "$AGENT_BIN"
  if [[ -d "$ROLLBACK_DIR/host" ]]; then
    mkdir -p "$VERCELIFY_LIB/host"
    rsync -a --checksum --delete "$ROLLBACK_DIR/host/" "$VERCELIFY_LIB/host/"
  fi
  [[ -f "$ROLLBACK_DIR/install.env" ]] && cp -a "$ROLLBACK_DIR/install.env" "$VERCELIFY_ETC/install.env"
  cp -a "$ROLLBACK_DIR/units/." "$SYSTEMD_DIR/" 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true
  local u
  for u in $UNITS; do systemctl try-restart "$u" 2>/dev/null || true; done
}

# The agent answers /v1/health within N seconds.
agent_healthy() {
  local i
  for i in $(seq 1 "${1:-60}"); do
    curl -fsS -m 2 "$AGENT_LOCAL_URL/v1/health" >/dev/null 2>&1 && return 0
    (( i < ${1:-60} )) && sleep 1
  done
  return 1
}

cmd_update() {
  need_root update
  local chan=${channel:-stable} ref='' tmp rc=0
  while (( $# )); do
    case "$1" in
      --edge) chan=edge ;;
      --stable) chan=stable ;;
      --ref) ref=${2:?usage: vercelify update --ref TAG}; shift ;;
      *) die "unknown option $1 (use --edge, --stable or --ref TAG)" ;;
    esac
    shift
  done
  tmp=$(mktemp)
  if [[ -n "${VERCELIFY_INSTALLER:-}" ]]; then cp "$VERCELIFY_INSTALLER" "$tmp"
  else fetch "https://raw.githubusercontent.com/$VERCELIFY_REPO/main/install.sh" "$tmp" || die "download failed"; fi
  snapshot_for_rollback
  info "previous version kept for rollback (vercelify rollback)"
  local args=(-y)
  [[ $ROLE == worker ]] && args+=(--worker)
  VERCELIFY_NONINTERACTIVE=1 VERCELIFY_CHANNEL=$chan VERCELIFY_REF=$ref bash "$tmp" "${args[@]}" || rc=$?
  rm -f "$tmp"
  if (( rc != 0 )) || ! agent_healthy "${UPDATE_HEALTH_SECS:-60}"; then
    err "update failed (exit $rc) — restoring the previous agent and scripts"
    restore_rollback
    agent_healthy "${UPDATE_HEALTH_SECS:-60}" && ok "rolled back; the previous version is running again" ||
      err "the previous agent did not come back either — see: journalctl -u vercelify-agent -n 50"
    die "update failed; full log: $VERCELIFY_LOG"
  fi
  ok "updated (channel $chan)"
}

cmd_rollback() {
  need_root rollback
  restore_rollback
  agent_healthy 30 || die "the agent did not come back — see: journalctl -u vercelify-agent -n 50"
  ok "rolled back to the version installed before the last update (Docker, Coolify and your data are unchanged)"
}

cmd_uninstall() {
  need_root uninstall
  confirm "Remove the Vercelify agent, power guard, firewall and CLI? (Coolify, apps and data stay)" n || exit 0
  local u c
  # Sleeping apps: wake them and drop the proxy's wake route while the agent
  # can still do it, or they stay down behind a route to nothing.
  for u in $( (agent_api GET /v1/sleep | jq -r '.settings[]?.app_uuid') 2>/dev/null); do
    (agent_api PUT "/v1/sleep/$u" '{"enabled":false}' >/dev/null) 2>/dev/null || warn "could not wake $u — start it in Coolify"
  done
  # Vercelify's own containers (data stays): without the firewall, Ollama's
  # API would answer anyone on the network.
  for c in "${OLLAMA_CONTAINER:-vercelify-ollama}" "${REGISTRY_CONTAINER:-vercelify-registry}"; do
    docker inspect "$c" >/dev/null 2>&1 || continue
    docker rm -f "$c" >/dev/null && info "removed the $c container (its data stays)"
  done
  for u in vercelify-agent vercelify-mesh vercelify-power-guard vercelify-firewall; do
    systemctl disable --now "$u" >/dev/null 2>&1 || true
    rm -f "$SYSTEMD_DIR/$u.service"
  done
  for u in vercelify-backup vercelify-routes vercelify-maintenance; do
    systemctl disable --now "$u.timer" >/dev/null 2>&1 || true
    rm -f "$SYSTEMD_DIR/$u.timer" "$SYSTEMD_DIR/$u.service"
  done
  systemctl daemon-reload
  rm -f "$AGENT_BIN" "${MESH_BIN:-/usr/local/bin/vercelify-mesh}" "${CLI_LINK:-/usr/local/bin/vercelify}"
  rm -rf "$VERCELIFY_LIB"
  ok "removed. Config kept in $VERCELIFY_ETC (delete it yourself if you like)."
  info "Coolify itself: see https://coolify.io/docs/get-started/uninstallation"
}

main() {
  local cmd=${1:-status}
  (( $# )) && shift
  case "$cmd" in
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    pair) cmd_pair "$@" ;;
    domain) cmd_domain "$@" ;;
    add-worker) cmd_add_worker "$@" ;;
    llm|ai) cmd_llm "$@" ;;
    autodeploy|auto-deploy) cmd_autodeploy "$@" ;;
    logs) cmd_logs "$@" ;;
    coolify) cmd_coolify "$@" ;;
    backup|backups) need_root backup; backup_cli "$@" ;;
    registry) need_root registry; registry_cli "$@" ;;
    routes) need_root routes; [[ $ROLE == main ]] || die "run this on the main host"; routes_sync ;;
    maintenance) need_root maintenance; maintenance_cli "$@" ;;
    sleep) cmd_sleep "$@" ;;
    mesh) mesh_cli "$@" ;;
    standby) need_root standby; standby_cli "$@" ;;
    promote) cmd_promote "$@" ;;
    demote) cmd_demote "$@" ;;
    tokens) need_root tokens; "$AGENT_BIN" --config "$VERCELIFY_ETC/agent.toml" tokens "$@" ;;
    update) cmd_update "$@" ;;
    rollback) cmd_rollback ;;
    uninstall) cmd_uninstall ;;
    version|--version|-v) echo "vercelify ${version:-dev} ($ROLE)"; "$AGENT_BIN" --version 2>/dev/null || true ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"

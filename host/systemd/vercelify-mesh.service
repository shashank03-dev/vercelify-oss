[Unit]
Description=Vercelify mesh (private WireGuard network, vfy0)
Documentation=https://github.com/shashank03-dev/vercelify-oss/blob/main/docs/design/SYSTEM-DESIGN.md
After=network-online.target
Wants=network-online.target
# The agent and Docker may start later: the mesh comes first.
Before=vercelify-agent.service

[Service]
Type=simple
ExecStart=/usr/local/bin/vercelify-mesh --dir /var/lib/vercelify/mesh --run-dir /run/vercelify up --acl-hook "/usr/local/lib/vercelify/firewall.sh mesh"
Restart=always
RestartSec=2
Environment=RUST_LOG=vercelify_mesh=info
RuntimeDirectory=vercelify
RuntimeDirectoryPreserve=yes
# A tun device, addresses, port 53 on the mesh address and the firewall hook.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target

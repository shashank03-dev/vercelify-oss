[Unit]
Description=Vercelify power & thermal guard
Documentation=https://github.com/shashank03-dev/vercelify-oss
After=docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/local/lib/vercelify/power-guard.sh --daemon
Restart=always
RestartSec=10
RuntimeDirectory=vercelify
RuntimeDirectoryPreserve=yes
StateDirectory=vercelify

[Install]
WantedBy=multi-user.target

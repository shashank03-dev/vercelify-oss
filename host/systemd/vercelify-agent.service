[Unit]
Description=Vercelify host agent (the engine and the app's API)
Documentation=https://github.com/shashank03-dev/vercelify-oss
After=network-online.target docker.service vercelify-mesh.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vercelify-agent --config /etc/vercelify/agent.toml serve
Restart=always
RestartSec=3
Environment=RUST_LOG=info,tower_http=warn
# Root is required for docker, chown of volume directories and systemctl;
# everything else is locked down.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
# BuildKit (git builds): buildx keeps its builder and activity in /root/.docker.
ExecStartPre=+/bin/mkdir -p /root/.docker
ReadWritePaths=/root/.docker
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

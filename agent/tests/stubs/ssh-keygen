#!/bin/sh
# Stub `ssh-keygen -y -f FILE`: prints a public key for Coolify's key.
echo "ssh-keygen $*" >> "${STUB_LOG:-/dev/null}"
case "$3" in
  */ssh_key@key-uuid-1) echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHkLyFOm2v3pq6tYp2kQ0Q8Xc1sR2mJ3dZy7vC9p0Abc" ;;
  *) echo "Load key \"$3\": No such file or directory" >&2; exit 255 ;;
esac

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vercelify",
  "version": "0.2.0",
  "identifier": "dev.vercelify.cockpit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vercelify",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0a0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Self-hosted Vercel control center",
    "longDescription": "Control your self-hosted Coolify PaaS, storage tiers, Tailscale mesh and display streaming from one app.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
